# Datheon Enterprise Forward Deployed Engineering (FDE) Environment Variables
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Security & Cryptographic Tokens
SECRET_KEY=datheon_vpc_hardened_secret_key_884920261028
ADMIN_API_KEY=fde_admin_secops_token_9934
HITL_HMAC_SECRET=datheon_hitl_cryptographic_audit_secret_2026

# Vector Store Backend ('memory' or 'qdrant')
VECTOR_STORE_BACKEND=memory
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=datheon_enterprise_knowledge
VECTOR_DIMENSION=384

# Model Configurations
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
ENABLE_CROSS_ENCODER_RERANKER=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval & Guardrail Thresholds
DEFAULT_RETRIEVAL_TOP_K=8
RERANK_TOP_K=4
SIMILARITY_THRESHOLD=0.35
STRICT_CITATION_GUARDRAIL=true
MIN_CITATION_CONFIDENCE=0.70

# Agent Parameters
AGENT_MAX_ITERATIONS=6
